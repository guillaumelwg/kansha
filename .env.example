# Copy to .env and fill in real values. .env is gitignored; this template is committed.

# Supabase Postgres connection string.
# Supabase dashboard -> Connect -> URI (use the Session Pooler string for IPv4 compatibility).
DATABASE_URL=postgres://user:password@host:5432/postgres?sslmode=require

# Resend API key (transactional email), from resend.com dashboard.
RESEND_API_KEY=
