<div class="max-w-xl">
  <h1 class="font-serif text-2xl text-ink">Saved</h1>
  <p class="mt-2 text-sm text-muted">Your gratitude has been saved.</p>

  <blockquote class="mt-6 whitespace-pre-wrap break-words rounded-md border border-border bg-white p-4 text-ink">
    <%= @entry.body %>
  </blockquote>

  <% if @unclaimed_share %>
    <%= render "shared", share: @unclaimed_share %>
  <% elsif !@share_claimed %>
    <%= render "share_cta", entry: @entry %>
  <% end %>

  <%= link_to "Write another", root_path, class: "mt-6 inline-block text-sm text-sage underline" %>
</div>
