<h1 class="font-serif text-2xl text-ink">My Gratitudes</h1>

<% if @entries.empty? %>
  <p class="mt-4 text-sm text-muted">
    Nothing here yet. <%= link_to "Write your first entry", root_path, class: "text-sage underline" %>.
  </p>
<% else %>
  <ul class="mt-6 space-y-4">
    <% @entries.each do |entry| %>
      <li>
        <%= link_to entry_path(entry), class: "block cursor-pointer rounded-md border border-border bg-white p-4", data: { controller: "truncate" } do %>
          <p class="text-xs text-muted"><%= local_time(entry.created_at) %></p>
          <p class="mt-2 line-clamp-4 whitespace-pre-wrap break-words text-ink" data-truncate-target="text"><%= entry.body %></p>
          <p class="mt-2 hidden text-xs text-muted" data-truncate-target="label">Read more</p>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
