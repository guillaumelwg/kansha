<div class="max-w-xl">
  <h1 class="font-serif text-2xl text-ink">New Entry</h1>
  <p class="mt-2 text-sm text-muted">Write one thing you're grateful for.</p>

  <% if @entry.errors.any? %>
    <div class="mt-4 text-sm text-red-700">
      <ul class="list-inside list-disc">
        <% @entry.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @entry, class: "mt-6", data: { controller: "char-counter" } do |f| %>
    <%= f.text_area :body, rows: 8, autofocus: true, required: true, maxlength: 5000,
          data: { char_counter_target: "input", action: "input->char-counter#update" },
          class: "block w-full rounded-md border-border bg-white text-ink shadow-sm" %>

    <p class="mt-1 text-right text-xs text-muted" data-char-counter-target="count"></p>

    <%= f.submit "Save", class: "mt-4 min-h-[44px] rounded-md bg-sage px-4 py-2 text-sm font-medium text-white" %>
  <% end %>
</div>
