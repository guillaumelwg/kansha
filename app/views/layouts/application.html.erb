<!DOCTYPE html>
<html class="h-full">
  <head>
    <title>Kansha</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-full flex-col bg-background">
    <% if user_signed_in? %>
      <div class="container mx-auto flex justify-end px-5 pt-4">
        <%= link_to profile_path, "aria-label": "Profile",
              class: "flex h-11 w-11 items-center justify-center rounded-full text-muted hover:text-ink" do %>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
            <circle cx="12" cy="8" r="4"></circle>
            <path d="M4 20c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"></path>
          </svg>
        <% end %>
      </div>
    <% end %>

    <main class="container mx-auto w-full flex-1 px-5 <%= user_signed_in? ? "mt-2 pb-8" : "mt-8 pb-8" %>">
      <% if notice %><p class="notice mb-4 text-sm text-green-700"><%= notice %></p><% end %>
      <% if alert %><p class="alert mb-4 text-sm text-red-700"><%= alert %></p><% end %>

      <%= yield %>
    </main>

    <% if user_signed_in? %>
      <!-- sticky, not fixed: fixed-bottom elements can fail to paint on load in
           WebKit until the first scroll event. Sticky is laid out in normal
           flow (via the flex-column body + min-h-full) so it always paints,
           and still pins to the viewport bottom once content scrolls past it. -->
      <nav class="sticky inset-x-0 bottom-0 z-10 border-t border-border bg-background pb-[env(safe-area-inset-bottom)]">
        <div class="container mx-auto flex px-5">
          <%= link_to "New Entry", root_path,
                class: "px-4 py-3 text-sm font-medium border-b-2 #{current_page?(root_path) ? 'border-sage text-ink' : 'border-transparent text-muted hover:text-ink'}" %>
          <%= link_to "My Gratitudes", entries_path,
                class: "px-4 py-3 text-sm font-medium border-b-2 #{current_page?(entries_path) ? 'border-sage text-ink' : 'border-transparent text-muted hover:text-ink'}" %>
          <%= link_to "Gratitudes Received", received_path,
                class: "px-4 py-3 text-sm font-medium border-b-2 #{current_page?(received_path) ? 'border-sage text-ink' : 'border-transparent text-muted hover:text-ink'}" %>
        </div>
      </nav>
    <% end %>
  </body>
</html>
