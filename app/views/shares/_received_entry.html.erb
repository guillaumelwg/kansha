<div class="max-w-xl">
  <h1 class="font-serif text-2xl text-ink">
    <% if local_assigns.fetch(:viewer_is_sender, false) %>
      You shared this gratitude
    <% else %>
      <%= share.sender_name_snapshot %> sent you a gratitude
    <% end %>
  </h1>

  <blockquote class="mt-6 whitespace-pre-wrap break-words rounded-md border border-border bg-white p-4 text-ink">
    <%= share.entry_body_snapshot %>
  </blockquote>
</div>
