<% if current_user.id == @share.sender_id && @share.entry.present? %>
  <div class="max-w-xl">
    <h1 class="font-serif text-2xl text-ink">Your gratitude from <%= local_time(@share.entry.created_at) %></h1>

    <blockquote class="mt-6 whitespace-pre-wrap break-words rounded-md border border-border bg-white p-4 text-ink">
      <%= @share.entry.body %>
    </blockquote>

    <p class="mt-2 text-xs text-muted"><%= @share.claimed? ? "Seen by your recipient." : "Not yet seen by your recipient." %></p>
  </div>
<% else %>
  <%= render "shares/received_entry", share: @share, viewer_is_sender: current_user.id == @share.sender_id %>
<% end %>
